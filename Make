# ============================================================
# Makefile for Static Library Build (Part 3)
# Builds libmyutils.a and links client_static against it
# ============================================================

# Compiler and flags
CC = gcc
CFLAGS = -Wall -Wextra -g -Iinclude
AR = ar
ARFLAGS = rcs
LDFLAGS =

# Directories
SRC_DIR = src
INC_DIR = include
OBJ_DIR = obj
BIN_DIR = bin
LIB_DIR = lib

# Library
LIB_NAME = libmyutils.a
LIB = $(LIB_DIR)/$(LIB_NAME)

# Target executable (static-linked)
TARGET = $(BIN_DIR)/client_static

# Library sources (everything except main.c)
LIB_SRCS = $(filter-out $(SRC_DIR)/main.c, $(wildcard $(SRC_DIR)/*.c))
LIB_OBJS = $(LIB_SRCS:$(SRC_DIR)/%.c=$(OBJ_DIR)/%.o)

# Main object
MAIN_OBJ = $(OBJ_DIR)/main.o

# ============================================================
# Rules
# ============================================================

all: $(TARGET)

# --- Create static library ---
$(LIB): $(LIB_OBJS)
	@mkdir -p $(LIB_DIR)
	$(AR) $(ARFLAGS) $@ $^
	@echo "✓ Created static library: $@"

# --- Compile each source file to object ---
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	@mkdir -p $(OBJ_DIR)
	$(CC) $(CFLAGS) -c $< -o $@
	@echo "✓ Compiled: $< -> $@"

# --- Link main.o against the static library ---
$(TARGET): $(MAIN_OBJ) $(LIB)
	@mkdir -p $(BIN_DIR)
	$(CC) $(CFLAGS) -o $@ $(MAIN_OBJ) -L$(LIB_DIR) -lmyutils $(LDFLAGS)
	@echo "✓ Linked static: $@"

# --- Run the program ---
run: all
	./$(TARGET)

# --- Analyze the library ---
analyze: all
	@echo "=== Contents of $(LIB) ==="
	ar -t $(LIB)
	@echo ""
	@echo "=== Symbols in $(LIB) ==="
	nm $(LIB)
	@echo ""
	@echo "=== Symbols in $(TARGET) (filtered) ==="
	nm $(TARGET) | grep -E "mystr|wordCount|mygrep"
	@echo ""
	@echo "=== ELF header of $(TARGET) ==="
	readelf -h $(TARGET)

# --- Clean ---
clean:
	rm -f $(OBJ_DIR)/*.o $(LIB) $(TARGET)
	@echo "✓ Cleaned"

.PHONY: all run analyze clean
